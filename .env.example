# ═══════════════════════════════════════════════════════════
# Skyra Marketplace — Environment Variables Template
# Copy ke .env.local untuk development
# Deploy: set di Cloudflare Pages → Settings → Environment Variables
# ═══════════════════════════════════════════════════════════

# --- Supabase (public, aman di-expose ke frontend) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# --- Supabase Service Role (SERVER-SIDE ONLY, JANGAN NEXT_PUBLIC_) ---
# Buat /api/orders/create + webhook — bypass RLS
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# --- Midtrans ---
# Sandbox keys diawali "SB-", production tanpa prefix
MIDTRANS_SERVER_KEY=SB-Mid-server-xxxxx
MIDTRANS_SIGNATURE_KEY=Mid-server-xxxxx
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=SB-Mid-client-xxxxx
NEXT_PUBLIC_MIDTRANS_ENV=sandbox
